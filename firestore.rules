rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones Auxiliares
    function isAuthenticated() { return request.auth != null; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role; }
    function isAdmin() { return hasRole('admin') || (isAuthenticated() && request.auth.token.admin == true); }
    function isGestor() { return hasRole('gestor') || isAdmin(); }
    function isViewer() { return hasRole('viewer') || isGestor() || isAdmin(); }

    // ===================================================
    // COLECCIÓN: users (CORREGIDO PARA PERMITIR REGISTRO)
    // ===================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // PERMITIR que el usuario se cree a sí mismo O que un admin lo cree
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // --- MANTENER EL RESTO DE TUS REGLAS IGUAL ---
    match /clients/{clientId} { allow read: if isViewer(); allow create, update: if isGestor(); allow delete: if isAdmin(); }
    match /vehicles/{vehicleId} { allow read: if isViewer(); allow create, update: if isGestor(); allow delete: if isAdmin(); }
    match /import_processes/{processId} { allow read: if isViewer(); allow create: if isGestor(); allow update: if isGestor(); allow delete: if isAdmin(); }
    match /payments/{paymentId} { allow read: if isViewer(); allow create, update: if isGestor(); allow delete: if isAdmin(); }
    match /invoices/{invoiceId} { allow read: if isViewer(); allow create, update: if isGestor(); allow delete: if isAdmin(); }
    match /crm_activities/{activityId} { allow read: if isViewer(); allow create, update: if isGestor(); allow delete: if isAdmin(); }
    match /documents/{documentId} { allow read: if isViewer(); allow create, update: if isGestor(); allow delete: if isAdmin(); }
    match /settings/{settingId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /shipments/{shipmentId} { allow read: if isViewer(); allow create, update: if isGestor(); allow delete: if isAdmin(); }
    match /audit_logs/{logId} { allow read: if isAdmin(); allow write: if false; }
  }
}